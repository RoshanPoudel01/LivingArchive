// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────
// NextAuth Models
// ───────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────
// User
// ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  notes       Note[]
  tags        Tag[]
  notebooks   Notebook[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────
// Notebook (optional grouping for notes)
// ───────────────────────────────────────────

model Notebook {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String? // e.g. "#4f46e5"
  icon        String? // emoji or icon name e.g. "📓"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes  Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

// ───────────────────────────────────────────
// Note
// ───────────────────────────────────────────

model Note {
  id String @id @default(cuid())

  title     String
  emoji     String? // e.g. "📝" — shown on note card

  // Rich text — Tiptap JSON document stored as Json
  content   Json    @default("{\"type\":\"doc\",\"content\":[]}")

  // Stripped plain text for search/previews — populated server-side
  plainText String? @db.Text

  // Cover image (optional hero image at top of note)
  coverImage String?

  // Status flags
  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)
  isTrashed  Boolean @default(false)

  // Soft delete
  trashedAt DateTime?

  // Word/character counts — updated on save
  wordCount      Int @default(0)
  characterCount Int @default(0)

  // Relations
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  notebookId String?
  notebook   Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)

  tags        Tag[]
  attachments Attachment[]
  versions    NoteVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────
// Tag
// ───────────────────────────────────────────

model Tag {
  id    String  @id @default(cuid())
  name  String
  color String? // e.g. "#10b981"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes  Note[]

  createdAt DateTime @default(now())

  @@unique([name, userId])
}

// ───────────────────────────────────────────
// Attachment (images/files embedded in notes)
// ───────────────────────────────────────────

model Attachment {
  id       String @id @default(cuid())
  url      String // storage URL (S3, Cloudinary, etc.)
  filename String
  mimeType String
  size     Int    // bytes

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ───────────────────────────────────────────
// NoteVersion (revision history)
// ───────────────────────────────────────────

model NoteVersion {
  id        String @id @default(cuid())

  // Snapshot of content at time of save
  title     String
  content   Json
  plainText String? @db.Text

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
